{
  "compilerOptions": {
    "target": "es2019",
    "module": "es2020",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom", "dom.iterable"],
    "jsx": "react",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "outDir": "dist/js",
    "rootDir": "src",
    "removeComments": false,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
